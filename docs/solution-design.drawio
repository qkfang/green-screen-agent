        <mxCell id="law" value="&lt;b style=&quot;font-size:12px;color:#1F2937&quot;&gt;gsa-logs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4B5563&quot;&gt;Log Analytics · 30 days&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4B5563&quot;&gt;console + system logs&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9730D;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=10;spacingBottom=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="rg">
