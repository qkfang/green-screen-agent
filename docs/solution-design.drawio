        <mxCell id="app_live" value="&lt;b style=&quot;font-size:14px;color:#1F2937&quot;&gt;green-screen-live&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4B5563&quot;&gt;Python 3.12 · Starlette / uvicorn · MCP · tnz · 0.5 vCPU / 1 GiB · 1 replica&lt;/span&gt;&lt;br&gt;• &lt;span style=&quot;font-family:Courier New;font-size:12px;color:#1F2937&quot;&gt;/&lt;/span&gt; live green screen · &lt;span style=&quot;font-family:Courier New;font-size:12px;color:#1F2937&quot;&gt;/events&lt;/span&gt; SSE&lt;br&gt;• &lt;span style=&quot;font-family:Courier New;font-size:12px;color:#1F2937&quot;&gt;/api/tool&lt;/span&gt; · &lt;span style=&quot;font-family:Courier New;font-size:12px;color:#1F2937&quot;&gt;/api/keyboard&lt;/span&gt; (operator input)&lt;br&gt;• &lt;span style=&quot;font-family:Courier New;font-size:12px;color:#1F2937&quot;&gt;/mcp&lt;/span&gt; MCP streamable HTTP, 7 terminal tools:&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-family:Courier New;font-size:10px;color:#1F2937&quot;&gt;connect read_screen type_text type_credential&lt;br&gt;&amp;nbsp;&amp;nbsp;press_key wait_for_text disconnect&lt;/span&gt;&lt;br&gt;• IBM tnz terminal · settings from TN3270_* env vars&lt;br&gt;• Password from a Container Apps secret&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#146C2E&quot;&gt;Ingress: public HTTPS → 3271&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=62;spacingTop=8;spacingRight=10;spacingBottom=6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="env">
