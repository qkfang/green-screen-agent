# Copy to .env and adjust. .env is git-ignored.

# --- TN3270 host -------------------------------------------------------------
# Defaults point at the bundled simulator: python -m green_screen_agent.simulator
TN3270_HOST=127.0.0.1
TN3270_PORT=3270
TN3270_TLS=false
TN3270_TLS_VERIFY=true
# Comma-separated hosts (host or host:port) the agent may connect to; "*" = any.
# Default: only TN3270_HOST.
TN3270_ALLOWED_HOSTS=
# 24x80, 32x80, 43x80 or 27x132
TN3270_SCREEN_SIZE=24x80
TN3270_CODEPAGE=cp037
TN3270_TIMEOUT=30

# Sign-on credentials typed by the type_credential tool (never shown to the model).
# Simulator: DEMO / DEMO123. TK5: HERC01 / CUL8TR.
TN3270_USERNAME=
TN3270_PASSWORD=

# --- Microsoft Foundry agent ---------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_NAME=gpt-4.1
FOUNDRY_AGENT_NAME=green-screen-agent
