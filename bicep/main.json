{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "2671592437827410927"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "prefix": {
      "type": "string",
      "defaultValue": "gsa",
      "minLength": 2,
      "maxLength": 15,
      "metadata": {
        "description": "Short prefix for resource names."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "app": "green-screen-agent"
      },
      "metadata": {
        "description": "Tags applied to every resource."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.42.0.0/16",
      "metadata": {
        "description": "Address space of the virtual network."
      }
    },
    "infrastructureSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.42.0.0/23",
      "metadata": {
        "description": "Container Apps infrastructure subnet (workload profiles environments need at least /27)."
      }
    },
    "modelName": {
      "type": "string",
      "defaultValue": "gpt-4.1",
      "metadata": {
        "description": "Model deployed to Foundry for the prompt agent."
      }
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "2025-04-14",
      "metadata": {
        "description": "Version of the model."
      }
    },
    "developerPrincipalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional object ID of the developer who runs src\\agent locally; gets \"Azure AI User\" on Foundry."
      }
