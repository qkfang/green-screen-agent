    },
    "environmentName": {
      "type": "string",
      "value": "[format('{0}-env', parameters('prefix'))]"
    },
    "environmentDefaultDomain": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('prefix'))), '2024-03-01').defaultDomain]"
    },
    "infrastructureSubnetPrefix": {
      "type": "string",
      "value": "[parameters('infrastructureSubnetPrefix')]"
