          "appPrincipalId": {
            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('prefix'))), '2023-01-31').principalId]"
          },
          "developerPrincipalId": {
            "value": "[parameters('developerPrincipalId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "14081703742800299363"
            }
          },
          "parameters": {
            "name": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object",
              "defaultValue": {}
            },
            "modelName": {
              "type": "string",
              "defaultValue": "gpt-4.1",
              "metadata": {
                "description": "Model deployed for the prompt agent."
              }
            },
            "modelVersion": {
              "type": "string",
              "defaultValue": "2025-04-14",
              "metadata": {
                "description": "Version of the model."
              }
            },
            "modelCapacity": {
              "type": "int",
              "defaultValue": 100,
              "metadata": {
                "description": "Capacity of the GlobalStandard deployment, in thousands of tokens per minute."
              }
            },
            "appPrincipalId": {
              "type": "string",
              "metadata": {
                "description": "Object ID of the managed identity that runs the agent app; gets \"Azure AI User\" on the account."
              }
            },
            "developerPrincipalId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Optional object ID of a developer who runs the agent app locally; gets \"Azure AI User\" too."
              }
            }
          },
          "variables": {
            "azureAiUserRoleId": "53ca6127-db72-4b80-b1b0-d745d6d5456d"
          },
          "resources": [
            {
              "type": "Microsoft.CognitiveServices/accounts",
              "apiVersion": "2025-06-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
